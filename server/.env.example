# ==============================
# FlightZone AI — Server .env
# ==============================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── PostgreSQL (Supabase) ──
# Go to https://supabase.com → New Project → Settings → Database → Connection String (URI mode)
# Paste the full URI here (replace [YOUR-PASSWORD] in the Supabase string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── JWT ──
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=8h

# ── Server Config ──
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Aviationstack API ──
# 1. Go to https://aviationstack.com/signup/free
# 2. Create a free account (500 req/month on free tier)
# 3. Copy your API Access Key from the dashboard
AVIATIONSTACK_KEY=YOUR_AVIATIONSTACK_API_KEY_HERE

# ── OpenWeatherMap API ──
# 1. Go to https://home.openweathermap.org/users/sign_up
# 2. Create a free account
# 3. Go to API Keys tab → copy your default key (may take ~10 min to activate)
OPENWEATHERMAP_KEY=YOUR_OPENWEATHERMAP_API_KEY_HERE

# ── Resend (Email / Contact Form) ──
# 1. Go to https://resend.com/signup
# 2. Create a free account (3,000 emails/month free)
# 3. Go to API Keys → Create API Key → copy it here
# 4. Add & verify a sending domain (or use onboarding@resend.dev for testing)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=noreply@yourdomain.com
CONTACT_RECIPIENT_EMAIL=your-team-email@example.com
